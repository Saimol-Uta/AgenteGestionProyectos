# Centralized environment configuration example
# Copy this file to .env: cp .env.example .env
# Never commit real credentials, API keys, or passwords to version control.

# =============================================================================
# Web Platform Authentication & Session (Phase 2 & 3)
# =============================================================================
# Demonstration login credentials for local testing (change before production)
MANAGER_LOGIN_EMAIL=gestor@hormigestion.ec
MANAGER_LOGIN_PASSWORD=HormiGestion2026!

# Server notification recipient fallback when manager session email is not available
MANAGER_EMAIL=gestor@hormigestion.ec

# Session security and cookies
H5_SESSION_TTL_SECONDS=3600
H5_SESSION_COOKIE_SECURE=false

# Local operator identity and token (token requires at least 32 characters if set)
H5_OPERATOR_ACTOR=operador-local
H5_OPERATOR_TOKEN=

# =============================================================================
# Project Configuration & Storage Paths
# =============================================================================
# YAML configuration file for the active project
AGENTE_CONFIG_PATH=config/hormigestion.yaml

# SQLite persistence and job queue databases
AGENTE_DB_PATH=.runtime/agente.db
H5_WEB_JOBS_DB_PATH=.runtime/h5-web-jobs.sqlite

# Artifacts and branch workspaces
AGENTE_RUNS_DIR=runs
H5_OUTBOX_DIR=.runtime/outbox
BRANCHES_DIR=.runtime/branches

# =============================================================================
# Platform Capabilities & Governance Flags
# =============================================================================
H5_ANALYSIS_ENABLED=true
H5_GOVERNANCE_ENABLED=true
H5_REPORT_DECISIONS_ENABLED=true
H5_WEEKLY_CYCLE_ENABLED=true

# Server default permissions (strict boolean: true / false)
# Leaving remote keys empty automatically falls back to local deterministic sandboxes
ALLOW_REMOTE_AI=true
EXTERNAL_WRITES_ENABLED=true

# =============================================================================
# CORS & Allowed Hosts
# =============================================================================
H5_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
H5_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# =============================================================================
# AI Providers Configuration (Google Gemini & Groq)
# =============================================================================
# Google Gemini (Monitoring, Independent Verifier, and Report synthesis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MONITORING_MODEL=gemini-3.5-flash-lite
GEMINI_REPORT_MODEL=gemini-3.5-flash-lite
# MONITORING_MAX_GENERATION_TOKENS=1024

# Groq (Code Quality Review)
QUALITY_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Quality review context budgeting & timeouts
# QUALITY_CONTEXT_WINDOW=
QUALITY_MAX_OUTPUT_TOKENS=4096
QUALITY_CONTEXT_MARGIN=64
QUALITY_TIMEOUT_SECONDS=120.0
VERIFIER_TIMEOUT_SECONDS=120.0

# =============================================================================
# Data Sources & Analysis Engine
# =============================================================================
# Collection mode: fixtures (safe local baseline) or real (live API calls)
SOURCE_MODE=fixtures
POLICIES_PATH=config/policies.yaml
DUE_SOON_DAYS=7
TIMEZONE=America/Guayaquil
MAX_LLM_CALLS_PER_RUN=8

# =============================================================================
# Trello Integration
# =============================================================================
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=6a957e9173d4d13d0c5db608
# Task state strategy: date_fields (for phase boards) or list_mapping
TRELLO_STATE_STRATEGY=date_fields

# Optional multi-project boards mapping (JSON):
# TRELLO_BOARD_IDS={"HORMIGESTION":"6a957e9173d4d13d0c5db608"}

# Optional priority label IDs mapping (JSON):
# TRELLO_PRIORITY_LABELS={"HORMIGESTION":{"alta":"...","media":"...","baja":"..."}}

# =============================================================================
# GitHub Integration
# =============================================================================
GITHUB_TOKEN=
GITHUB_OWNER=Josu-F1
GITHUB_REPO=hormigestion-backend
# Alternative alias (specify either GITHUB_REPO or GITHUB_REPOSITORY=owner/repo, not contradictory):
# GITHUB_REPOSITORY=Josu-F1/hormigestion-backend
GITHUB_BRANCH=main
GITHUB_BASE_BRANCH=main
GITHUB_COMMIT_SHA=

# =============================================================================
# Email Notifications (SMTP)
# =============================================================================
# SMTP credentials; if unconfigured, notification receipts are saved locally to outbox
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# =============================================================================
# Weekly Automated Cycle (Optional Schedule)
# =============================================================================
# Weekday: 0=Monday .. 6=Sunday
# H5_WEEKLY_SCHEDULE_PROJECT_ID=HORMIGESTION
# H5_WEEKLY_SCHEDULE_WEEKDAY=0
# H5_WEEKLY_SCHEDULE_LOCAL_TIME=09:00
# H5_WEEKLY_SCHEDULE_TIMEZONE=America/Guayaquil
# H5_WEEKLY_SCHEDULE_WINDOW_RULE=previous_full_week

# =============================================================================
# HTTP Transport Budgets
# =============================================================================
HTTP_TIMEOUT_SECONDS=30.0
HTTP_MAX_RESPONSE_BYTES=10485760
