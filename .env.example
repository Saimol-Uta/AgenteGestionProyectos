# Centralized environment configuration example
# Copy this file to .env: cp .env.example .env

# Google Gemini API key (keep blank for safe local execution; do NOT commit real keys)
GEMINI_API_KEY=

# Remote AI providers opt-in policy (strict boolean: false / true)
ALLOW_REMOTE_AI=false

# Ollama local runtime base URL (default port 11435 per ARCHITECTURA.v1)
OLLAMA_BASE_URL=http://127.0.0.1:11435

# Gemini model identifier for verification stage
GEMINI_MODEL=gemini-2.5-flash

# Bounded timeout in seconds for code quality reviews (optional, default: 120.0)
QUALITY_TIMEOUT_SECONDS=120.0

# Bounded timeout in seconds for independent verification reviews (optional, default: 120.0; set 220.0 to retain legacy budget)
VERIFIER_TIMEOUT_SECONDS=120.0

# -----------------------------------------------------------------------------
# Data Sources Configuration (T5b)
# -----------------------------------------------------------------------------
# Mode: fixtures (default) or real
SOURCE_MODE=fixtures

# Local quality policies YAML path (default: config/policies.yaml)
POLICIES_PATH=config/policies.yaml

# Trello credentials and board (never commit real tokens)
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
# Trello task state strategy: list_mapping (default) or date_fields (for phase boards, no list state IDs required)
TRELLO_STATE_STRATEGY=list_mapping

# GitHub credentials and repository scope
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_COMMIT_SHA=

# HTTP transport budgets (seconds, bytes)
HTTP_TIMEOUT_SECONDS=30.0
HTTP_MAX_RESPONSE_BYTES=10485760
